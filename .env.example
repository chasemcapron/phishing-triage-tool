# Copy to .env.local for local dev (`vercel dev`), and set the real values in
# Vercel > Project > Settings > Environment Variables. Never commit real keys.
# Any key left empty makes that check show "not configured"; everything else still works.

# Google Safe Browsing API v5 (Google Cloud project with the "Safe Browsing API" enabled)
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal public API key (Profile > API Key on virustotal.com)
VIRUSTOTAL_API_KEY=

# abuse.ch Auth-Key for URLhaus (auth.abuse.ch)
URLHAUS_AUTH_KEY=
